{"pageProps":{"post":{"id":"63qUdz5UQnZ78qOsPt7dUr","slug":"dust-product-update-1","title":"Dust Product Update 1","description":"Hi! Dust makes work work better with custom AI agents. The past month has been packed with powerful new features and upgrades. ⛵️Mistral Large Now Available •...","body":{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"Hi!","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{"uri":"https://dust.tt/w/cfc97c37aa"},"content":[{"data":{},"marks":[],"value":"Dust","nodeType":"text"}],"nodeType":"hyperlink"},{"data":{},"marks":[],"value":" makes work work better with custom AI agents.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"The past month has been packed with powerful new features and upgrades.","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":" ⛵️Mistral Large Now Available ","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"• You can now access Mistral Large via the new @mistral-large global agent (you can also use it to build custom agents).","nodeType":"text"},{"data":{},"marks":[],"value":"\n","nodeType":"text"},{"data":{},"marks":[],"value":"• Mistral Large, is the latest and most advanced language model from Mistral.","nodeType":"text"},{"data":{},"marks":[],"value":"\n","nodeType":"text"},{"data":{},"marks":[],"value":"🔗 ","nodeType":"text"},{"data":{"uri":"https://mistral.ai/news/mistral-large/"},"content":[{"data":{},"marks":[],"value":"https://mistral.ai/news/mistral-large/","nodeType":"text"}],"nodeType":"hyperlink"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":" 🧠New Cutting-Edge Models from Anthropic","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"marks":[],"value":"• Claude 3 Opus is now powering the @claude-3 global agent, delivering a major performance boost over Claude 2.1.","nodeType":"text"},{"data":{},"marks":[],"value":"\n","nodeType":"text"},{"data":{},"marks":[],"value":"• Opus is Anthropic's most intelligent model, with best-in-market performance and a very lage context window (200k tokens).","nodeType":"text"},{"data":{},"marks":[],"value":"\n","nodeType":"text"},{"data":{},"marks":[],"value":"• All custom agents using Claude 2.1 have been automatically upgraded to Claude 3 Opus.","nodeType":"text"},{"data":{},"marks":[],"value":"\n","nodeType":"text"},{"data":{},"marks":[],"value":"🔗 ","nodeType":"text"},{"data":{"uri":"https://www.anthropic.com/news/claude-3-family"},"content":[{"data":{},"marks":[],"value":"https://www.anthropic.com/news/claude-3-family","nodeType":"text"}],"nodeType":"hyperlink"}],"nodeType":"paragraph"},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"751ge4ljeqso"}},"id":"4jh1Eway4MG4dvkBceyqve","type":"Asset","createdAt":"2025-12-03T13:18:51.038Z","updatedAt":"2025-12-03T13:18:51.038Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"Dust Product Update 1 - image-7.png","description":"Migrated from https://blog.dust.tt/content/images/2024/03/image-7.png","file":{"url":"//images.ctfassets.net/751ge4ljeqso/4jh1Eway4MG4dvkBceyqve/005401dcdb1b2e9276e7f6544d5371e0/image-7.png","details":{"size":231142,"image":{"width":1351,"height":865}},"fileName":"image-7.png","contentType":"image/png"}}}},"content":[]},{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":" 📊Introducing Table Queries","nodeType":"text"}],"nodeType":"heading-2"},{"data":{},"content":[{"data":{},"mar