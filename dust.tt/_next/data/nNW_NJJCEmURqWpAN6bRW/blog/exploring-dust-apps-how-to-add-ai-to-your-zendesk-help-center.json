Z","updatedAt":"2025-12-03T13:27:39.360Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"Easily add AI to your Zendesk Help Center - Dust Apps Example #1 - Screenshot-2024-05-06-at-14.03.50.png","description":"Migrated from https://blog.dust.tt/content/images/2024/05/Screenshot-2024-05-06-at-14.03.50.png","file":{"url":"//images.ctfassets.net/751ge4ljeqso/J7A8MrfkxkZ8V0DMJHFtc/4cc718433ffd82cc840427552ef6aedc/Screenshot-2024-05-06-at-14.03.50.png","details":{"size":16723,"image":{"width":1030,"height":166}},"fileName":"Screenshot-2024-05-06-at-14.03.50.png","contentType":"image/png"}}}},"content":[]},{"data":{},"content":[{"data":{},"marks":[],"value":"Choose the ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"GET","nodeType":"text"},{"data":{},"marks":[],"value":" method, and point to this URL : ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"YOUR_ZENDESK_URL.zendesk.com/api/v2/help_center/articles/search.json?query=${INPUT.query_string}","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"blockquote"},{"data":{},"content":[{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[{"type":"bold"}],"value":"Replace YOUR_ZENDESK_URL","nodeType":"text"},{"data":{},"marks":[],"value":" by your actual Zendesk Help Center URL","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"},{"data":{},"content":[{"data":{},"content":[{"data":{},"marks":[],"value":"The ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"${INPUT.query_string}","nodeType":"text"},{"data":{},"marks":[],"value":" variable will ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"use the output from the preceding INPUT block","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"mark