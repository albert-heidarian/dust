"paragraph"}],"nodeType":"list-item"}],"nodeType":"unordered-list"},{"data":{},"content":[{"data":{},"marks":[],"value":"Here we will use the Dust App from an agent, so we need to ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"create a Dataset","nodeType":"text"},{"data":{},"marks":[],"value":" and add ","nodeType":"text"},{"data":{},"marks":[{"type":"bold"}],"value":"query_string","nodeType":"text"},{"data":{},"marks":[],"value":" as the only argument in the schema. ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"You will then be able to add data entries to your dataset, which in our case will ","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"only be used to try your Dust App","nodeType":"text"},{"data":{},"marks":[],"value":", as if a user was asking these questions directly to the app.","nodeType":"text"}],"nodeType":"paragraph"},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"751ge4ljeqso"}},"id":"7F7p0BTQxONjUYOGrdajny","type":"Asset","createdAt":"2025-12-03T13:27:30.228Z","updatedAt":"2025-12-03T13:27:30.228Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"Easily add AI to your Zendesk Help Center - Dust Apps Example #1 - Screenshot-2024-05-06-at-14.47.08.png","description":"Migrated from https://blog.dust.tt/content/images/2024/05/Screenshot-2024-05-06-at-14.47.08.png","file":{"url":"//images.ctfassets.net/751ge4ljeqso/7F7p0BTQxONjUYOGrdajny/f9378693c32b81261e8d6cfff2a3b433/Screenshot-2024-05-06-at-14.47.08.png","details":{"size":119928,"image":{"width":1934,"height":1346}},"fileName":"Screenshot-2024-05-06-at-14.47.08.png","contentType":"image/png"}}}},"content":[]},{"data":{},"content":[{"data":{},"marks":[],"value":"Back to your INPUT block, select the dataset you ju